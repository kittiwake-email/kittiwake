# Postfix integration with Kittiwake.
#
# Kittiwake's "socketmap" mode serves a socketmap on [::1]:2525 (see
# listen.postfix in kittiwake.yaml). Postfix uses it to know which domains and
# recipients exist, so unknown recipients are rejected at SMTP time. Mail is
# then handed to Kittiwake over LMTP.

# Domains Kittiwake hosts (enabled domains only).
virtual_mailbox_domains = socketmap:inet:[::1]:2525:domains

# Recipients that resolve to a mailbox (accounts, aliases, catch-all).
virtual_mailbox_maps = socketmap:inet:[::1]:2525:mailboxes

# Optional: let Postfix expand aliases itself. Kittiwake already fans out
# aliases at LMTP time, so this is only needed if you want alias expansion
# visible in Postfix logs/queues (e.g. forwarding to external addresses).
virtual_alias_maps = socketmap:inet:[::1]:2525:aliases

# Deliver over LMTP. With HAProxy in front use its address and have it send
# the PROXY protocol; direct connection example:
virtual_transport = lmtp:inet:[::1]:24
lmtp_destination_recipient_limit = 1    # one recipient per LMTP transaction

# Namespaces in other datacenters (README "Proxies"): the transport map answers
# "lmtp:[<ingress host>]:<port>" for recipients of a namespace that has an ingress
# and NOTFOUND for everyone else, who then take virtual_transport. The ingress
# HAProxy spreads LMTP over that namespace's lmtp nodes (with PROXY protocol).
# For TLS on that hop, terminate it at the ingress and set lmtp_tls_wrappermode
# on a dedicated transport.
#transport_maps = socketmap:inet:[::1]:2525:transport

# Spam routing: Kittiwake files messages carrying this header/value into Junk
# (mail.spam_header / mail.spam_value in kittiwake.yaml). rspamd and
# SpamAssassin can add it.
#   X-Spam-Flag: YES

# Submission: Kittiwake submits outbound mail to smtp.relay_host; point that at
# a dedicated relay service of this Postfix instance (master.cf) and allow it in
# mynetworks or with SASL credentials.
#
# Per-account rate limiting (smtp.xclient: true in kittiwake.yaml): Kittiwake
# starts each relay session with XCLIENT LOGIN=<account uuid> ADDR=<client ip>,
# so Postfix treats the session as authenticated by that account
# (sasl_username) and logs the real client. XCLIENT LOGIN only takes effect
# with SASL enabled on that smtpd (verified on Postfix 3.8); the exceptions
# networks keep AUTH itself from being offered to anyone. On the relay service
# only:
#
# 1025 inet n - y - - smtpd
#   -o syslog_name=postfix/relay
#   -o smtpd_authorized_xclient_hosts=<kittiwake hosts>
#   -o smtpd_sasl_auth_enable=yes
#   -o smtpd_sasl_exceptions_networks=0.0.0.0/0,[::]/0
#   -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
#   -o smtpd_recipient_restrictions=check_policy_service,inet:127.0.0.1:10040,permit_sasl_authenticated,reject
#
# A policy service (postfwd, policyd-rate-limit, ...) keys its limits on
# sasl_username. Every message also carries "X-Kittiwake-Account: <uuid>" for
# header_checks, milters (rspamd) and log correlation.
