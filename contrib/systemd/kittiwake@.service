# Kittiwake instance template: one process per mode.
#   systemctl enable --now kittiwake@lmtp kittiwake@imap kittiwake@pop3 kittiwake@jmap \
#                          kittiwake@admin kittiwake@socketmap kittiwake@worker kittiwake@backup
# Every instance reads /etc/kittiwake/kittiwake.yaml; the instance name is the
# mode it runs, and the mode's own management (metrics/health) address comes
# from the same file (listen.<mode>.management). Nothing is passed from here
# but the mode.
[Unit]
Description=Kittiwake mail platform (%i)
Documentation=https://github.com/kittiwake-email/kittiwake
After=network-online.target
Wants=network-online.target
PartOf=kittiwake.target

[Service]
Type=simple
User=kittiwake
Group=kittiwake
ExecStart=/usr/local/bin/kittiwake serve -c /etc/kittiwake/kittiwake.yaml --modes %i
Restart=on-failure
RestartSec=2s
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kittiwake
StateDirectory=kittiwake

[Install]
WantedBy=kittiwake.target
