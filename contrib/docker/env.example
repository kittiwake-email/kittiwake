# Environment for contrib/docker/compose.yaml: copy to .env and fill in.
# Every KITTIWAKE_* variable overrides the same setting of the container's
# config file; `kittiwake help env` lists them all.

# The /64 routed to the Docker host; every container takes an address from it.
KITTIWAKE_IPV6_SUBNET=2001:db8:1::/64

# Metadata database. "db" is the MariaDB container of compose.yaml.
KITTIWAKE_DB_DSN=kittiwake:kittiwake@tcp(db:3306)/kittiwake
# KITTIWAKE_DB_READ_DSN=
# KITTIWAKE_DB_PROXY_DSN=kittiwake_proxy:secret@tcp(db:3306)/kittiwake

# Ceph: librados defaults for every storage connection (the clusters
# themselves are registered with kittiwake-admin storage add).
# KITTIWAKE_CEPH_CONFIG_FILE=/etc/ceph/ceph.conf

# Public name: JWT issuer and JMAP base URL.
KITTIWAKE_SESSION_ISSUER=https://mail.example.org

# Outbound relay (Postfix) and how to talk to it.
KITTIWAKE_SMTP_RELAY_HOST=[2001:db8:1::25]:25
# KITTIWAKE_SMTP_TLS=opportunistic
# KITTIWAKE_SMTP_USERNAME=
# KITTIWAKE_SMTP_PASSWORD=

# Client-facing listeners: off (clients connect directly), optional, or
# required (behind HAProxy with send-proxy-v2).
# KITTIWAKE_PROXY_PROTOCOL=optional
# KITTIWAKE_PROXY_TRUSTED_ADDRESSES=2001:db8:1::10,2001:db8:1::11
# KITTIWAKE_SUBMISSION_REQUIRE_TLS_PROXY=true

# The proxy mode's site key (kittiwake-admin proxy-key create <site>).
# KITTIWAKE_PROXY_AUTH=local
# KITTIWAKE_PROXY_HANDOFF_KEY=

# Backups (the backup container only).
# KITTIWAKE_BACKUP_TARGET=s3
# KITTIWAKE_BACKUP_S3_ENDPOINT=https://s3.example.net
# KITTIWAKE_BACKUP_S3_BUCKET=kittiwake-backups
# KITTIWAKE_BACKUP_S3_ACCESS_KEY=
# KITTIWAKE_BACKUP_S3_SECRET_KEY=
# KITTIWAKE_BACKUP_KEY=            # 32 random bytes in hex (openssl rand -hex 32); escrow it

# KITTIWAKE_LOG_LEVEL=info
# KITTIWAKE_LOG_FORMAT=json
